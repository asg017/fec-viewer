  <!-- Appended to the Info.plist that cargo-bundle generates. Don't repeat
       keys it already writes (identifier, version, NSHighResolutionCapable…). -->

  <!-- Declare the .fec type so Finder knows what it is... -->
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key><string>gov.fec.filing</string>
      <key>UTTypeDescription</key><string>FEC Electronic Filing</string>
      <key>UTTypeConformsTo</key>
      <array><string>public.data</string><string>public.content</string></array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key><array><string>fec</string></array>
      </dict>
    </dict>
  </array>

  <!-- ...and claim it as the default viewer. -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key><string>FEC Electronic Filing</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>LSHandlerRank</key><string>Owner</string>
      <key>LSItemContentTypes</key><array><string>gov.fec.filing</string></array>
    </dict>
  </array>
